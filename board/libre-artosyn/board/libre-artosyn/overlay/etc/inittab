# /etc/inittab

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t tmpfs tmpfs /dev
::sysinit:/bin/mount -a

::sysinit:/bin/mkdir -p /dev/pts
::sysinit:/bin/mkdir -p /dev/shm
::sysinit:/bin/mknod -m 666 /dev/null c 1 3
::sysinit:/bin/mknod -m 600 /dev/console c 5 1
::sysinit:/bin/mknod -m 666 /dev/tty c 5 0
::sysinit:/bin/mknod -m 666 /dev/zero c 1 5
::sysinit:/bin/mknod -m 666 /dev/random c 1 8
::sysinit:/bin/mknod -m 666 /dev/urandom c 1 9

::sysinit:/bin/mount -t tmpfs -o mode=1777 tmpfs /tmp
::sysinit:/bin/mount -t tmpfs -o mode=0755 tmpfs /run
::sysinit:/bin/mount -t tmpfs -o mode=0755 tmpfs /var

::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/usr/bin/env GLIBC_TUNABLES=glibc.pthread.rseq=0 /etc/init.d/rcS
console::askfirst:/usr/bin/env GLIBC_TUNABLES=glibc.pthread.rseq=0 /bin/cttyhack /bin/sh
::shutdown:/usr/bin/env GLIBC_TUNABLES=glibc.pthread.rseq=0 /etc/init.d/rcK
